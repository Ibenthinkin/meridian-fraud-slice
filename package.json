{
  "name": "meridian-fraud-slice",
  "version": "0.1.0",
  "private": true,
  "description": "A deployable slice of a fraud decisioning platform for a fictitious investment firm, built with AWS CDK in TypeScript.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:core": "vitest run test/core.test.ts",
    "synth": "cdk synth --quiet",
    "verify": "npm run typecheck && npm run test && npm run synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy --require-approval broadening --outputs-file cdk-outputs.json",
    "destroy": "cdk destroy",
    "demo": "tsx scripts/demo.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-eventbridge": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.10.0",
    "aws-cdk": "^2.1000.0",
    "aws-cdk-lib": "^2.200.0",
    "cdk-nag": "^2.35.0",
    "constructs": "^10.4.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
